# Code Signing Certificate (Windows)
# Để build có chữ ký số, tạo file .env với các biến sau:

# Option 1: Dùng file .pfx (self-signed hoặc mua từ CA)
# Chạy scripts/create-self-signed-cert.ps1 để tạo self-signed cert
CSC_LINK=./certs/code-signing.pfx
CSC_KEY_PASSWORD=your-password-here

# Option 2: Không ký (build bình thường, Windows sẽ hiện cảnh báo SmartScreen)
# Để trống hoặc xóa các dòng trên

# GitHub Actions (CI/CD)
# GH_TOKEN=your-github-token

# Launcher -> web backend
VXC_WEB_BASE_URL=https://voxelxclient.vercel.app
